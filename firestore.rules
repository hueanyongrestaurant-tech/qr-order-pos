rules_version = '2';

// กฎความปลอดภัยของ Firestore สำหรับ QR Order POS
// ─────────────────────────────────────────────────────────────────────────────
// หลักการ:
// • ฝั่งลูกค้า (ไม่ได้ล็อกอิน) — อ่านเมนู/หมวดหมู่/สถานะร้านได้ และ "สร้าง" ออเดอร์
//   ใหม่ของโต๊ะตัวเองได้เท่านั้น (สถานะเริ่มต้องเป็น "in-progress")
// • ฝั่งพนักงาน (ล็อกอินด้วย Firebase Auth) — แก้ไขข้อมูลได้ตามงานหน้าร้าน
// • ออเดอร์ห้ามลบถาวรเด็ดขาด — การ "ยกเลิก" ทำผ่าน update สถานะเป็น "cancelled"
// • activityLogs เป็นบันทึกร่องรอย — สร้างได้ อ่านได้ แต่ห้ามแก้/ห้ามลบ

service cloud.firestore {
  match /databases/{database}/documents {

    match /orders/{orderId} {
      allow create: if request.resource.data.status == "in-progress"
                    && request.resource.data.tableNumber is string
                    && (
                      request.resource.data.tableNumber.matches('^[0-9]+-[0-9]+$')
                      || request.resource.data.isTakeaway == true
                    );
      allow read: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;   // ห้ามลบออเดอร์ทิ้งถาวรเด็ดขาด — บังคับผ่าน update สถานะ "cancelled" เท่านั้น
    }

    match /activityLogs/{logId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update, delete: if false;   // log ต้องแก้ไข/ลบไม่ได้เลย ป้องกันการลบร่องรอย
    }

    match /voidReasons/{docId} {
      allow read, write: if request.auth != null;
    }

    // ─── เมนู / หมวดหมู่ — ลูกค้าอ่านได้ พนักงานแก้ได้ ───
    match /menuItems/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ─── สถานะร้าน (แบนเนอร์ "ร้านยุ่ง") — ลูกค้าอ่าน พนักงานเขียน ───
    match /status/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ─── ตัวนับคิวกลับบ้าน (T-1, T-2, ...) — เฉพาะพนักงาน ───
    match /counters/{docId} {
      allow read, write: if request.auth != null;
    }

    // ─── บัญชีรายจ่าย — เฉพาะพนักงาน ───
    match /expenses/{docId} {
      allow read, write: if request.auth != null;
    }

    match /expenseItems/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
