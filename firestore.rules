rules_version = '2';

// กฎความปลอดภัยของ Firestore สำหรับ QR Order POS
// ─────────────────────────────────────────────────────────────────────────────
// หลักการ:
// • ฝั่งลูกค้า (ไม่ได้ล็อกอิน) — อ่านเมนู/หมวดหมู่/สถานะร้านได้ และ "สร้าง" ออเดอร์
//   ใหม่ของโต๊ะตัวเองได้เท่านั้น (สถานะเริ่มต้องเป็น "in-progress")
//   ยกเว้นเจ้าของเพิ่ม "บิลขายย้อนหลัง" ที่สร้างเป็น "paid" ได้เลย (ดูเงื่อนไขใน /orders)
// • ฝั่งพนักงาน (ล็อกอินด้วยบัญชีของร้าน — isStaff) — แก้ไขข้อมูลได้ตามงานหน้าร้าน
// • ออเดอร์ห้ามลบถาวรเด็ดขาด — การ "ยกเลิก" ทำผ่าน update สถานะเป็น "cancelled"
// • activityLogs เป็นบันทึกร่องรอย — พนักงานสร้างได้ เจ้าของอ่านได้ ห้ามแก้/ห้ามลบ
// • สองบัญชี: เจ้าของ (isOwner — owner@hueanyong.local) เห็นทุกอย่าง | พนักงาน (admin@hueanyong.local) ทำงานหน้าร้านได้ครบ
//   แต่อ่านยอดขายย้อนหลังไม่ได้: ไล่ดู (list) ออเดอร์ได้เฉพาะที่ยังไม่ปิด, อ่านสถิติ/รายจ่าย/บันทึกกิจกรรมไม่ได้
//   (แอปซ่อนแท็บพวกนี้ให้พนักงานอยู่แล้ว — rules นี้คือตัวบังคับจริง ดู src/app/staff/roleStore.ts)
// • บัญชีอื่นใดที่ล็อกอินได้ (เช่นสมัครเองด้วย API key ในหน้าเว็บ) = เท่ากับลูกค้าที่ไม่ได้ล็อกอิน (isStaff() ไม่ผ่าน)

service cloud.firestore {
  match /databases/{database}/documents {

    // เจ้าของร้าน — ต้องตรงกับ OWNER_EMAIL ใน src/app/constants.ts (ตัวพิมพ์เล็กทั้งหมด)
    function isOwner() {
      return request.auth != null && request.auth.token.email == 'owner@hueanyong.local';
    }

    // บัญชีของร้านเท่านั้น (พนักงาน + เจ้าของ) — "ล็อกอินแล้ว" อย่างเดียวไม่พอ: ใครก็สมัครบัญชี Firebase Auth ใหม่ได้ด้วย
    // API key ที่อยู่ในหน้าเว็บ บัญชีแบบนั้นต้องไม่ได้สิทธิ์อะไรเลย | ต้องตรงกับ STAFF_EMAIL / OWNER_EMAIL ใน src/app/constants.ts
    // เพิ่มบัญชีของร้าน = เพิ่มอีเมลในรายการนี้ (แล้ววาง rules ใหม่)
    function isStaff() {
      return request.auth != null
        && request.auth.token.email in ['admin@hueanyong.local', 'owner@hueanyong.local'];
    }

    match /orders/{orderId} {
      // ทางที่ 2 (บิลขายย้อนหลัง): เจ้าของสร้างบิลที่ "จ่ายแล้ว" ได้ตรงๆ โดยต้องมี
      // backfilled == true และ createdAt (= เวลาขายจริงที่กรอก) ต้องไม่อยู่ในอนาคต และย้อนหลังไม่เกิน 72 ชม.
      // ไม่ผ่าน in-progress เลย จึงไม่เข้า listener หน้าออเดอร์ → ไม่พิมพ์/ไม่มีเสียง/ไม่กระทบตัวนับร้านยุ่ง
      allow create: if request.resource.data.tableNumber is string
                    && (
                      request.resource.data.tableNumber.matches('^[0-9]+-[0-9]+$')
                      || request.resource.data.isTakeaway == true
                    )
                    && (
                      request.resource.data.status == "in-progress"
                      || (
                        isOwner()   // บิลขายย้อนหลังลงจากหน้าประวัติ (เจ้าของเท่านั้น)
                        && request.resource.data.status == "paid"
                        && request.resource.data.backfilled == true
                        && request.resource.data.createdAt is timestamp
                        && request.resource.data.createdAt <= request.time
                        && request.resource.data.createdAt > request.time - duration.value(72, 'h')
                      )
                    );
      // อ่านทีละใบ (get) ต้องรู้ id — พนักงานต้องใช้: ทุก transaction (เสิร์ฟ/ยกเลิก/ปิดบิล/ย้ายโต๊ะ) อ่านใบนั้นก่อนเขียน
      // รวมถึงใบที่เพิ่งถูกปิดจากเครื่องอื่น (เช็คจอค้าง) id เป็นรหัสสุ่ม ไล่เดาไม่ได้
      allow get: if isStaff();
      // ไล่ดู (list): เจ้าของได้ทั้งหมด | พนักงานได้เฉพาะออเดอร์ที่ยังไม่ปิด — query ต้องกรอง status เป็น
      // in-progress / awaiting-payment เอง (หน้าออเดอร์, ปิดบิล, ย้ายโต๊ะ กรองแบบนี้อยู่แล้ว)
      // query ตามวันที่/ทั้ง collection/บิล paid-cancelled = ยอดขายย้อนหลัง → ปฏิเสธ
      allow list: if isOwner()
                  || (isStaff() && resource.data.status in ['in-progress', 'awaiting-payment']);
      allow update: if isStaff() && closedOrderStaysClosed();
      allow delete: if false;   // ห้ามลบออเดอร์ทิ้งถาวรเด็ดขาด — บังคับผ่าน update สถานะ "cancelled" เท่านั้น

      // บิลที่จ่ายแล้ว / ยกเลิกแล้ว ห้ามเปลี่ยนสถานะอีก (แก้ช่องอื่นได้ เช่นวิธีจ่าย) — กันเครื่องที่จอค้าง
      // กดเสิร์ฟ/ยกเลิกจากข้อมูลเก่า แล้วดึงบิลเก่ากลับมาเป็นออเดอร์ค้าง → ปริ้นซ้ำทุกจุด + ไปรวมบิลรอบถัดไป
      // (เคส 2-2 วันที่ 30 ต.ค. 69) ข้อยกเว้นเดียว: ยกเลิกบิลขายย้อนหลัง (backfilled) จากหน้าประวัติ
      // แก้ใน Firebase Console ไม่ผ่าน rules นี้ (แก้มือได้ตามเดิม)
      function closedOrderStaysClosed() {
        let before = resource.data.status;
        let after = request.resource.data.status;
        return !(before in ['paid', 'cancelled'])
          || after == before
          || (before == 'paid' && after == 'cancelled' && resource.data.get('backfilled', false) == true && isOwner());
      }
    }

    match /activityLogs/{logId} {
      allow create: if isStaff();   // พนักงาน/เจ้าของต้องจดได้เสมอ (รวมใน transaction ย้ายโต๊ะ)
      allow read: if isOwner();
      allow update, delete: if false;   // log ต้องแก้ไข/ลบไม่ได้เลย ป้องกันการลบร่องรอย
    }

    match /voidReasons/{docId} {
      allow read, write: if isStaff();
    }

    // ─── เมนู / หมวดหมู่ — ลูกค้าอ่านได้ พนักงานแก้ได้ ───
    match /menuItems/{itemId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ─── สต็อกต่อเมนู (stock/{itemId}) — ไม่มี doc = ขายไม่จำกัด ───
    // พนักงานแก้ได้ทุกอย่าง | ลูกค้า (ไม่ได้ล็อกอิน/บัญชีอื่น) "ลด remaining" ได้อย่างเดียว และต้องเป็นการเขียน
    // ใน commit เดียวกับการสร้างออเดอร์ใหม่ (lastOrderId = id ออเดอร์นั้น: ก่อน commit ต้องยังไม่มี
    // หลัง commit ต้องมีและเป็น in-progress) — ออเดอร์ที่ไม่มีเมนูติดสต็อกไม่ผ่าน rule นี้เลย
    match /stock/{itemId} {
      allow read: if true;
      allow create, delete: if isStaff();
      allow update: if isStaff() || customerTakesStock();

      function customerTakesStock() {
        let before = resource.data;
        let after = request.resource.data;
        let orderPath = /databases/$(database)/documents/orders/$(after.lastOrderId);
        return after.diff(before).affectedKeys().hasOnly(["remaining", "lastOrderId"])
          && before.remaining is int
          && after.remaining is int
          && after.remaining >= 0
          && after.remaining < before.remaining
          && before.remaining - after.remaining <= 50
          && after.lastOrderId is string
          && !exists(orderPath)
          && getAfter(orderPath).data.status == "in-progress";
      }
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ─── สถานะร้าน (แบนเนอร์ "ร้านยุ่ง") — ลูกค้าอ่าน พนักงานเขียน ───
    match /status/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ─── ลิงก์โต๊ะ + สรุป "ที่สั่งไปแล้ว" (tableViews/{รหัสสุ่มในลิงก์ ?t=}) — เครื่องพนักงานเขียน ลูกค้าเปิดดู ───
    // get = เปิด doc เดียวที่ต้องรู้ id (รหัสในลิงก์/QR) — ลูกค้าทำได้
    // list = ไล่ดูทั้ง collection — เฉพาะพนักงาน ไม่งั้นคนนอกได้รหัสของทุกโต๊ะ
    // (ห้ามย้ายไปไว้ใน /status — status ให้ทุกคน list ได้)
    match /tableViews/{token} {
      allow get: if true;
      allow list: if isStaff();
      allow create, update, delete: if isStaff();
    }

    // ─── รายชื่อเครื่องพิมพ์ทั้งร้าน (printers/{MAC} — ชื่อ + Bluetooth MAC) — เฉพาะบัญชีของร้าน ───
    // ไม่อยู่ใน /status เพราะ status ใครก็อ่านได้ | เครื่องพิมพ์ที่เลือก/หน้าที่ของแต่ละเครื่องอยู่บนเครื่อง ไม่ได้อยู่ที่นี่
    match /printers/{printerId} {
      allow read, write: if isStaff();
    }

    // ─── จองโต๊ะ (reservations/{id}) — มีชื่อ/เบอร์ลูกค้า: เฉพาะบัญชีของร้าน ห้ามเปิดให้ลูกค้าอ่านเด็ดขาด ───
    // เก็บเท่าที่ต้องใช้: date, time, tables, name (+ phone, partySize, note ถ้ากรอก) | เครื่องเจ้าของลบรายการเก่าเกิน 30 วันเอง
    // ต้องตรงกับ RESERVATION_LIMITS ใน src/app/reservations.ts
    match /reservations/{reservationId} {
      allow read, delete: if isStaff();
      allow create, update: if isStaff() && validReservation(request.resource.data);

      function validReservation(d) {
        return d.keys().hasAll(['date', 'time', 'tables', 'name'])
          && d.keys().hasOnly(['date', 'time', 'tables', 'name', 'phone', 'partySize', 'note', 'createdAt', 'updatedAt'])
          && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.time is string && d.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && d.tables is list && d.tables.size() >= 1 && d.tables.size() <= 20
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 80
          && (!('phone' in d) || (d.phone is string && d.phone.size() <= 30))
          && (!('partySize' in d) || (d.partySize is int && d.partySize >= 1 && d.partySize <= 200))
          && (!('note' in d) || (d.note is string && d.note.size() <= 300));
      }
    }

    // ─── ตัวนับคิวกลับบ้าน (T-1, T-2, ...) + ตัวกันชน (table-moves, tableLinkLock) — เฉพาะบัญชีของร้าน ───
    match /counters/{docId} {
      allow read, write: if isStaff();
    }

    // ─── บัญชีรายจ่าย — เฉพาะเจ้าของ ───
    match /expenses/{docId} {
      allow read, write: if isOwner();
    }

    match /expenseItems/{docId} {
      allow read, write: if isOwner();
    }

    // ─── ยอดสรุปรายวัน (dailyStats/{YYYY-MM-DD}) — หน้าสถิติสร้างเองตอนต้องใช้ เฉพาะเจ้าของ ───
    match /dailyStats/{day} {
      allow read: if isOwner();
      allow write: if isOwner() && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
  }
}
